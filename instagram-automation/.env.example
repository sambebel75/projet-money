# .env.example — Template de configuration
# Copiez ce fichier vers .env et remplissez avec vos clés

# ============================================
# API KEYS (gratuites avec crédits offerts)
# ============================================

# Option 1 : Anthropic Claude (recommandé)
# Inscrivez-vous sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Option 2 : OpenAI GPT
# Inscrivez-vous sur https://platform.openai.com
OPENAI_API_KEY=sk-...

# ============================================
# NOTION (CRM & Content Database)
# ============================================

# Créez une intégration sur https://www.notion.so/my-integrations
# Puis partagez votre database avec cette intégration
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=votre_database_id_ici

# ============================================
# BUFFER (Publication automatique - optionnel)
# ============================================

# Connectez votre compte sur https://buffer.com/developers
BUFFER_ACCESS_TOKEN=...
BUFFER_ID=...

# ============================================
# META / INSTAGRAM BUSINESS (optionnel)
# ============================================

# Via Facebook Developer : https://developers.facebook.com
INSTAGRAM_BUSINESS_ID=...
FACEBOOK_PAGE_ID=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...

# ============================================
# MAKE / N8N (Workflow automation - optionnel)
# ============================================

MAKE_WEBHOOK_URL=https://hook.make.com/...

# ============================================
# SYSTEME.IO (Affiliation & Tunnel de vente)
# ============================================

SYSTEME_IO_API_KEY=...
SYSTEME_IO_CAMPAIGN_TAG=...

# ============================================
# OTHER (optionnel)
# ============================================

# Leonardo.ai pour génération d'images
LEONARDO_API_KEY=...

# Pexels API pour B-roll gratuit
PEXELS_API_KEY=...

# Google Sheets (pour analytics)
GOOGLE_SHEETS_ID=...
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
